# Copy to .env and fill in every value below. No quotes needed — paste raw.
# See SETUP.md at the project root for exactly where each one comes from.

# --- Database (Supabase Postgres) ---
DATABASE_URL=

# --- LLM / research ---
GEMINI_API_KEY=
TAVILY_API_KEY=

# --- Gmail OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# Fernet key used to encrypt stored Gmail refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- App ---
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CRON_SECRET=
CORS_ORIGINS=http://localhost:3000
